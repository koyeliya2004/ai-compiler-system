{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PipelineOutput",
  "description": "Final validated output from the AI Compiler pipeline",
  "type": "object",
  "required": ["app_name", "pipeline_version", "schemas", "metadata"],
  "properties": {
    "app_name": {"type": "string"},
    "pipeline_version": {"type": "string"},
    "intent": {"type": "object"},
    "blueprint": {"type": "object"},
    "schemas": {
      "type": "object",
      "required": ["ui_config", "api_config", "db_schema", "auth_config"],
      "properties": {
        "ui_config": {
          "type": "object",
          "required": ["pages"],
          "properties": {
            "pages": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "name", "route"],
                "properties": {
                  "id": {"type": "string"},
                  "name": {"type": "string"},
                  "route": {"type": "string"},
                  "auth_required": {"type": "boolean"},
                  "allowed_roles": {"type": "array", "items": {"type": "string"}},
                  "components": {"type": "array"}
                }
              }
            }
          }
        },
        "api_config": {
          "type": "object",
          "required": ["base_path", "endpoints"],
          "properties": {
            "base_path": {"type": "string"},
            "endpoints": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["method", "path"],
                "properties": {
                  "id": {"type": "string"},
                  "method": {"type": "string", "enum": ["GET","POST","PUT","DELETE","PATCH"]},
                  "path": {"type": "string"},
                  "auth_required": {"type": "boolean"},
                  "allowed_roles": {"type": "array", "items": {"type": "string"}}
                }
              }
            }
          }
        },
        "db_schema": {
          "type": "object",
          "required": ["tables"],
          "properties": {
            "database_type": {"type": "string"},
            "tables": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "columns"],
                "properties": {
                  "name": {"type": "string"},
                  "columns": {"type": "array"},
                  "relations": {"type": "array"}
                }
              }
            }
          }
        },
        "auth_config": {
          "type": "object",
          "required": ["strategy", "roles"],
          "properties": {
            "strategy": {"type": "string"},
            "roles": {"type": "array", "items": {"type": "string"}},
            "permissions": {"type": "object"},
            "token_expiry_hours": {"type": "number"}
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "total_latency_ms": {"type": "number"},
        "is_executable": {"type": "boolean"},
        "repair_counts": {"type": "object"},
        "assumptions": {"type": "array"},
        "warnings": {"type": "array"}
      }
    }
  }
}
