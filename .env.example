# AI Compiler System — Environment Variables
# Copy this to .env and fill in your values

# LLM Provider: groq (free, recommended) or openai
LLM_PROVIDER=groq

# Groq API Key (free at console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API Key (only needed if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# Model to use
# Groq options: llama-3.3-70b-versatile (best), llama3-8b-8192 (fastest)
# OpenAI options: gpt-4o, gpt-4o-mini
LLM_MODEL=llama-3.3-70b-versatile

# Logging level
PIPELINE_LOG_LEVEL=INFO
